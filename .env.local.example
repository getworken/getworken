# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (Server-Only)
# IMPORTANT: This should be the ENTIRE service account JSON as a single line
# You can get this from Firebase Console > Project Settings > Service Accounts
FIREBASE_SERVICE_ACCOUNT='{"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}'

# Sentry Configuration (Production Monitoring)
# ✅ DIAMOND STANDARD: Observability & Monitoring
# Get your DSN from: https://sentry.io/settings/projects/
# Sentry provides:
#   - Error tracking with stack traces
#   - APM (Application Performance Monitoring)
#   - RUM (Real User Monitoring)
#   - Core Web Vitals tracking (LCP, FID, CLS)
#   - Session Replay for debugging
NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_AUTH_TOKEN=your_sentry_auth_token_for_source_maps

# Application Version (for Sentry release tracking)
NEXT_PUBLIC_APP_VERSION=1.0.0

# Launch Mode
# Set to 'false' for pre-launch (only homepage/waitlist accessible)
# Set to 'true' to enable all routes (login, signup, dashboard, etc.)
NEXT_PUBLIC_LAUNCH_MODE=false

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
