{
  "name": "getworken",
  "version": "1.0.0",
  "private": true,
  "description": "GetWorken - Diamond Standard Architecture",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env TURBOPACK=0 next build",
    "prebuild:pre-launch": "node -e \"const fs=require('fs');['src/app/api','src/app/[locale]/(authed)','src/app/[locale]/(public)','src/app/[locale]/profile','src/app/[locale]/test-firebase','src/app/[locale]/sentry-test','src/app/[locale]/sentry-example-page','src/app/[locale]/home-example','src/app/actions'].forEach(p=>{if(fs.existsSync(p))fs.renameSync(p,p+'_disabled')})\"",
    "build:pre-launch": "cross-env NEXT_PUBLIC_LAUNCH_MODE=false TURBOPACK=0 next build",
    "postbuild:pre-launch": "node -e \"const fs=require('fs');['src/app/api_disabled','src/app/[locale]/(authed)_disabled','src/app/[locale]/(public)_disabled','src/app/[locale]/profile_disabled','src/app/[locale]/test-firebase_disabled','src/app/[locale]/sentry-test_disabled','src/app/[locale]/sentry-example-page_disabled','src/app/[locale]/home-example_disabled','src/app/actions_disabled'].forEach(p=>{if(fs.existsSync(p))fs.renameSync(p,p.replace('_disabled',''))})\"",
    "build:launch": "cross-env NEXT_PUBLIC_LAUNCH_MODE=true TURBOPACK=0 next build",
    "start": "next start",
    "lint": "next lint",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md,css}\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testMatch='**/__tests__/integration/**/*.test.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "emulators": "cross-env PATH=\"C:\\Program Files\\Java\\jdk-21\\bin;%PATH%\" firebase emulators:start",
    "emulators:exec": "firebase emulators:exec",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "postinstall": "test \"$NODE_ENV\" != \"production\" && husky install || echo 'Skipping husky in production'",
    "firebase:deploy:pre-launch": "npm run build:pre-launch && firebase deploy --only hosting",
    "firebase:deploy:launch": "npm run build:launch && firebase deploy --only hosting",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,storage:rules",
    "logs:view": "node -e \"console.log('\\nRecent logs:\\n'); require('child_process').execSync('dir /s /b logs\\\\*.log', {stdio:'inherit'})\"",
    "logs:clean": "node -e \"const fs=require('fs'),path=require('path');['sentry','firebase','dev'].forEach(d=>{const dir=path.join('logs',d);fs.existsSync(dir)&&fs.readdirSync(dir).filter(f=>f.endsWith('.log')).forEach(f=>fs.unlinkSync(path.join(dir,f)))});console.log('Logs cleaned!')\"",
    "logs:size": "node -e \"const fs=require('fs'),path=require('path');let total=0;['sentry','firebase','dev'].forEach(d=>{const dir=path.join('logs',d);fs.existsSync(dir)&&fs.readdirSync(dir).filter(f=>f.endsWith('.log')).forEach(f=>total+=fs.statSync(path.join(dir,f)).size)});console.log('Total log size:',Math.round(total/1024)+'KB')\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.24.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^11.0.2",
    "firebase-admin": "^13.6.0",
    "input-otp": "^1.4.2",
    "jotai": "^2.10.3",
    "lucide-react": "^0.553.0",
    "next": "16.0.1",
    "next-intl": "^4.5.0",
    "next-themes": "^0.4.6",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.2",
    "react": "19.0.0",
    "react-day-picker": "^9.11.1",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.66.1",
    "react-resizable-panels": "^3.0.6",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7",
    "thread-stream": "^3.1.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76",
    "cross-env": "^10.1.0",
    "tailwindcss": "^3.4.15",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.49.1",
    "@storybook/addon-a11y": "^10.0.6",
    "@storybook/addon-docs": "^10.0.6",
    "@storybook/nextjs": "^10.0.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-storybook": "10.0.6",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "storybook": "^10.0.6",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
