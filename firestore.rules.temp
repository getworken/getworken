rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // TEMPORARY: Allow all authenticated users to read/write for testing
    // TODO: Implement proper RBAC after initial setup
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
    
    // Alternative: If you want to test without authentication
    // Uncomment below and comment out the above rule
    // WARNING: This allows ANYONE to read/write your database!
    // match /{document=**} {
    //   allow read, write: if true;
    // }
  }
}
